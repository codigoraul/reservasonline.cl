---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Cta from '../../components/Cta.astro';
import Icon from '../../components/Icon.astro';
import { servicios } from '../../data/servicios';
---

<Base
  title="Funciones del sistema de reservas online | Reservas Online"
  description="Reservas 24 horas, agenda por profesional, enlace propio, recordatorios, cambios y bloqueos. Conoce cada función del sistema de reservas online."
>
  <Header />
  <main id="contenido">
    <section class="phero phero--plain">
      <div class="wrap">
        <p class="crumbs"><a href="/">Inicio</a> / Servicios</p>
        <h1>Todo lo que incluye el sistema</h1>
        <p class="phero__lead">Cada función explicada, para que sepas qué recibes en tu plan.</p>
      </div>
    </section>
    <section class="section">
      <div class="wrap">
        <ul class="svc-grid">
          {servicios.map((s) => (
            <li>
              <a href={`/servicios/${s.slug}`}>
                <span class="icon-tile icon-tile--grad"><Icon name={s.icon} /></span>
                <h2>{s.nombre}</h2>
                <p>{s.lead}</p>
                <span class="more">Ver más →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <Cta />
  </main>
  <Footer />
</Base>
