---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Cta from '../../components/Cta.astro';
import FaqList from '../../components/FaqList.astro';
import Icon from '../../components/Icon.astro';
import { servicios } from '../../data/servicios';
import { whatsappLink } from '../../data/site';

export function getStaticPaths() {
  return servicios.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const otros = servicios.filter((x) => x.slug !== s.slug);
---

<Base title={s.title} description={s.description}>
  <Header />
  <main id="contenido">
    <section class="phero" style={`--bg:url(${s.img})`}>
      <div class="wrap">
        <p class="crumbs"><a href="/">Inicio</a> / <a href="/servicios">Servicios</a> / {s.nombre}</p>
        <h1>{s.h1}</h1>
        <p class="phero__lead">{s.lead}</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={whatsappLink(`Hola, quiero información sobre: ${s.nombre}.`)} rel="noopener">Consultar por WhatsApp</a>
          <a class="btn btn--light-outline" href="/planes">Ver planes</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap split">
        <div>
          <div class="section__head"><h2>Qué obtienes</h2></div>
          <ul class="checks">{s.puntos.map((p) => <li>{p}</li>)}</ul>
        </div>
        <img class="split__img" src={s.img} alt="" width="1600" height="1067" loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="section faq">
      <div class="wrap">
        <div class="section__head"><h2>Preguntas sobre esta función</h2></div>
        <FaqList items={s.faqs} />
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section__head"><h2>Otras funciones incluidas</h2></div>
        <ul class="chips">
          {otros.map((o) => <li><a href={`/servicios/${o.slug}`}>{o.nombre}</a></li>)}
        </ul>
      </div>
    </section>

    <Cta wa={`Hola, quiero información sobre: ${s.nombre}.`} />
  </main>
  <Footer />
</Base>
