---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import { rubros } from '../data/rubros';
import { site, whatsappLink } from '../data/site';

export function getStaticPaths() {
  return rubros.map((r) => ({ params: { rubro: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const otros = rubros.filter((x) => x.slug !== r.slug);
const url = `${site.url}/${r.slug}`;
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: r.h1, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: r.h1,
    serviceType: 'Sistema de reservas online',
    areaServed: { '@type': 'Country', name: 'Chile' },
    provider: { '@type': 'Organization', name: site.name, url: site.url },
    description: r.description,
    url,
  },
];
---

<Base title={r.title} description={r.description}>
  <Header />
  <main id="contenido">
    <section class="phero" style={`--bg:url(${r.img})`}>
      <div class="wrap">
        <p class="crumbs"><a href="/">Inicio</a> / {r.nombre}</p>
        <h1>{r.h1}</h1>
        <p class="phero__lead">{r.lead}</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={whatsappLink(r.wa)} rel="noopener">Consultar por WhatsApp</a>
          <a class="btn btn--light-outline" href={site.demoUrl} rel="noopener">Probar la demo</a>
        </div>
        <p class="phero__lead" style="font-size:1rem;margin-top:1.25rem">Desde <strong>$12.000 al mes</strong> para hasta 3 profesionales.</p>
      </div>
    </section>

    <section class="section features">
      <div class="wrap">
        <div class="section__head">
          <h2>Lo que complica la agenda de {r.corto}</h2>
          <p>Y cómo lo resuelven las reservas online.</p>
        </div>
        <dl class="feature-list">
          {
            r.dolores.map(([ic, t, d]) => (
              <div class="feature">
                <span class="icon-tile"><Icon name={ic} /></span>
                <dt>{t}</dt>
                <dd>{d}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section tint">
      <div class="wrap split">
        <div>
          <div class="section__head"><h2>Qué obtienes</h2></div>
          <ul class="checks">{r.beneficios.map((b) => <li>{b}</li>)}</ul>
        </div>
        <img class="split__img" src={r.img} alt={r.alt} width="1600" height="1067" loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="section">
      <div class="wrap split">
        <div>
          <div class="section__head"><h2>{r.agendaTitulo}</h2></div>
          <ul class="checks">{r.agenda.map((a) => <li>{a}</li>)}</ul>
          <p style="margin-top:1rem;color:var(--muted)">{r.agendaNota}</p>
        </div>
        <div>
          <div class="section__head"><h2>Funcionando en tres pasos</h2></div>
          <ol class="steps">
            {r.pasos.map(([t, d]) => (
              <li>
                <h3>{t}</h3>
                <p>{d}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="scope">
      <div class="wrap">
        <p class="scope__note"><strong>Alcance del servicio.</strong> {r.alcance}</p>
      </div>
    </section>

    <section class="section faq">
      <div class="wrap">
        <div class="section__head"><h2>Preguntas de {r.corto}</h2></div>
        <FaqList items={r.faqs} />
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section__head"><h2>Reservas online para otros rubros</h2></div>
        <ul class="chips">
          {otros.map((o) => <li><a href={`/${o.slug}`}>{o.h1}</a></li>)}
        </ul>
      </div>
    </section>

    <Cta wa={r.wa} />
  </main>
  <Footer />
  {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</Base>
